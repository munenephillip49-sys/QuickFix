  type VARCHAR(50),
  title VARCHAR(255),
  message TEXT,
  related_request_id UUID
    REFERENCES public.service_requests(id)
    ON DELETE CASCADE,
  is_read BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMPTZ DEFAULT NOW()
