-- ============================================================
-- 22. PROVIDER RATING
-- ============================================================

CREATE OR REPLACE FUNCTION public.update_provider_rating()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN

  UPDATE public.providers
  SET
    total_reviews = (
      SELECT COUNT(*)
      FROM public.reviews
      WHERE provider_id = NEW.provider_id
    ),

    rating = (
      SELECT COALESCE(AVG(rating), 0)
      FROM public.reviews
      WHERE provider_id = NEW.provider_id
    ),

    updated_at = NOW()

  WHERE id = NEW.provider_id;

  RETURN NEW;

END;
$$;


DROP TRIGGER IF EXISTS trigger_update_provider_rating
ON public.reviews;


CREATE TRIGGER trigger_update_provider_rating
AFTER INSERT OR UPDATE
ON public.reviews
FOR EACH ROW
EXECUTE FUNCTION public.update_provider_rating();


-- ============================================================
-- 23. QUICKFIX COMMISSION
-- EXACTLY 2%
-- ============================================================

CREATE OR REPLACE FUNCTION public.calculate_commission(
  p_amount NUMERIC
)
RETURNS TABLE (
  commission NUMERIC,
  provider_earnings NUMERIC
)
LANGUAGE plpgsql
AS $$
BEGIN

  RETURN QUERY
  SELECT
    ROUND(p_amount * 0.02, 2),
    ROUND(p_amount * 0.98, 2);

END;
$$;


